# Copy this file to .env and fill it in. Never put .env on GitHub.
PORT=3000

# Websites allowed to call the API (several: separate with commas)
FRONTEND_URL=http://localhost:5173

# Database
DB_SERVER=localhost
DB_NAME=GarageManagement
# On our laptops: leave DB_USER empty -> Windows Authentication (ODBC Driver 18)
# Online (Azure SQL): fill both -> SQL login (see database/create_app_user.sql)
DB_USER=
DB_PASSWORD=

# Long random text used to sign the login tokens (different online and on the laptop)
JWT_SECRET=your_secret_key
